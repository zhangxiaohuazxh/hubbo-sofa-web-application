<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration xmlns="https://www.jooq.org/xsd/jooq-runtime-3.20.10.xsd"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://www.jooq.org/xsd/jooq-runtime-3.20.10.xsd">
    <!--
      连接信息通过系统属性 / 环境变量注入，禁止提交真实凭据到仓库。
      用法示例: mvn -Ddb.url=jdbc:postgresql://localhost:5432/hubbo -Ddb.user=pg -Ddb.password=xxx
    -->
    <jdbc>
        <driver>org.postgresql.Driver</driver>
        <url>${db.url}</url>
        <user>${db.user}</user>
        <password>${db.password}</password>
    </jdbc>

    <generator>
        <database>
            <inputSchema>public</inputSchema>
            <includes>t_user|t_menu</includes>
            <excludes>test</excludes>
        </database>
        <target>
            <packageName>cn.hubbo.dal</packageName>
            <directory>src/main/java</directory>
        </target>
        <pojos>true</pojos>
        <interfaces>true</interfaces>
        <daos>true</daos>
    </generator>


</configuration>